/* my official waybar */
{
  "layer": "top",
  "position": "top",
  "margin-top": 3,
  "modules-left": ["custom/launcher", "clock", "image#Memhack_icon", "image#anki_icon", "tray"],
  "modules-center": ["hyprland/workspaces", "custom/media"],
  "modules-right": ["network", "cpu", "memory", "custom/aur", "custom/pacman", "backlight"],

  "tray": {
    "icon-size": 19,
  },

  "image#Memhack_icon": {
      "path": "/home/DROS/Pictures/Icons/Memhack.png",
      "size": 22,
      "on-click": "xdg-open https://memhack.fluency.io/home",
  },

  "image#anki_icon": {
      "path": "/usr/local/share/pixmaps/anki.xpm",
      "size": 18, 
      "tooltip": "Launch Anki",
      "on-click": "anki"
  },

  "custom/aur": {
  "format": "{} <span size='120%'></span>",
  "interval": "once",
  "exec": "yay -Qua | wc -l",
  "on-click": "kitty -e sh -c 'yay -Syua; pkill -SIGRTMIN+9 waybar'",
  "signal": 9
  },

  "custom/pacman": {
    "format": " {}  ",
    "interval": "once",
    "exec": "checkupdates | wc -l",
    "on-click": "kitty -e sh -c 'sudo pacman -Syu; pkill -SIGRTMIN+8 waybar'",
    "signal": 8
  },

  "cpu": {
    "format": "{usage}% ",
    "on-click": "kitty -e btop",
  },

  "memory": {
    "format": "{}% ",
    "on-click": "kitty -e btop",
  },

  "custom/launcher": {
    "format": "󰣇",
    "on-click": "wlogout"
  },

  "custom/media": {
    "format": "{}",
    "escape": true,
    "return-type": "json",
    "max-length": 40,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl stop",
    "smooth-scrolling-threshold": 2, // This value was tested using a trackpad, it should be lowered if using a mouse.
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "exec": "$HOME/.config/waybar/scripts/mediaplayer.py 2> /dev/null" // Script in resources/custom_modules folder
  },

  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "clock": {
    "format-alt": "󰥔   {:%I:%M %p}",
    "format": "󰥔 {:%a %d/%b %I:%M %p}"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": "󰂱  {volume}%",
    "format-muted": "󰖁",
    "scroll-step": 1,
    "on-click": "GDK_BACKEND=x11 pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"],
    "format-icons": {
      "headphone": "  ",
      "hands-free": " ",
      "headset": "󰋎 ",
      "phone": " ",
      "portable": " ",
      "car": "",
      "default": ["󰖀", "󰕾"]
    }
  },

  "network": {
    "interface": "wlp9s0",
    "format": "{ifname}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀   {ipaddr}/{cidr}",
    "format-disconnected": "󰤭   disconnected",
    "max-length": 50,
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "on-click": "kitty -e nmtui",
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "urgent": "󰀨",
      "active": "",
      "default": ""
    },

    "sort-by-number": true
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  },

  "custom/weather": {
    "exec": "${HOME}/.config/waybar/scripts/get_weather.sh Araguaina+Brazil",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 3600
  }
}
