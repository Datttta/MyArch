/* waybar-capsule */
{
  "layer": "top",
  "position": "bot",
  "margin-top": 3,
  "margin-bottom":3,
  "include": ["~/.config/waybar/modules.jsonc"],
  "modules-left": ["custom/launcher", "clock", "custom/anki_notification", "group/trays"],
  "modules-center": ["hyprland/workspaces", "custom/media"],
  "modules-right": ["network", "cpu", "memory", "temperature", "backlight", "pulseaudio", "keyboard-state", "group/updates"],

  "hyprland/workspaces": {
      "active-only": false,
      "all-outputs": true,
      "format": "{icon}",
      "show-special": false,
      "on-click": "activate",
      "on-scroll-up": "hyprctl dispatch workspace e+1",
      "on-scroll-down": "hyprctl dispatch workspace e-1",
          "persistent-workspaces": {
        "*": 0
      },
      
      "format-icons": {
          "active": "",
          "default": ""
          
      }
  }
}
