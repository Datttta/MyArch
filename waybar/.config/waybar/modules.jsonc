{
  // ======================================== UPDATE MODULES ========================================
  "group/updates": {
    "orientation": "horizontal",
    "drawer": {
        "transition-duration": 600,
        "transition-to-left": true,
        "click-to-reveal": false,
        "hover-to-reveal": true
    },
    "modules": ["custom/updates", "custom/aur", "custom/flatpak"]
  },

  "custom/updates": {
      "tooltip": false,
      "exec": "~/.config/waybar/scripts/waybar_hub.sh update",
      "interval": 14400, // 4 hours
      "signal": 1
  },

  "custom/aur": {
  "format": "{} <span size='120%'>󱉚</span>",
  "exec": "~/.config/waybar/scripts/waybar_hub.sh get_yay_numbers",
  "on-click": "~/.config/waybar/scripts/waybar_hub.sh yay",
  "interval": "once",
  "signal": 2
  },

  "custom/flatpak": {
    "format": " {} <span size='120%'>󱑢</span>",
    "exec": "~/.config/waybar/scripts/waybar_hub.sh get_flatpak_numbers",
    "on-click": "~/.config/waybar/scripts/waybar_hub.sh flatpak",
    "interval": "once",
    "signal": 2
  },

  // ======================================== TRAYS ========================================
  "tray": {
    "icon-size": 19
  },

  "group/trays": {
    "orientation": "horizontal",
    "drawer": {
        "transition-duration": 600,
        "transition-to-left": true,
        "click-to-reveal": false,
        "hover-to-reveal": true
    },
    "modules": ["custom/trays", "tray"]
  },

  "custom/trays": {
    "tooltip": false,
    "format": "{} <span size='120%'></span>"
  },

  // ======================================== ANKI REVIEW REMINDER ========================================
  "custom/anki_notification": {
    "tooltip": false,
    "exec": "python ~/.config/waybar/scripts/Due_cards.py",
    "on-click": "pkill -9 anki; setsid anki > /dev/null 2>&1 &",
    "interval": 20,
    "signal": 3
  },

  // ======================================== SHOW CAPSLOCK STATE ========================================
  "keyboard-state": {
      "numlock": false,
      "capslock": true,
      "format": "{icon}",
      "device-path": "/dev/input/by-id/usb-SZH_usb_keyboard-event-kbd",
      "format-icons": {
          "locked": "<span size='180%'>󱍳 </span>",
          "unlocked": ""
      }
  },

  // ======================================== TEMPERATURE ========================================
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
    "critical-threshold": 80,
    "format": "{temperatureC}°C <span size='110%'></span>",
    "format-critical": "{temperatureC}°C <span size='110%'></span>",
    "interval": 5
  },

  // ======================================== CPU USAGE ========================================
  "cpu": {
    "format": "{usage}% ",
    "on-click": "hyprctl dispatch 'hl.dsp.exec_cmd(\"kitty -e btop\")'",
    "interval": 2
  },

  // ======================================== MEMORY USAGE ========================================
  "memory": {
    "format": "{}% ",
    "on-click": "hyprctl dispatch 'hl.dsp.exec_cmd(\"kitty -e btop\")'",
    "interval": 2
  },

  // ======================================== ARCH SYMBOL ========================================
  "custom/launcher": {
    "format": "<span size='130%'>󰣇</span>",
    "on-click": "wlogout"
  },

  // ======================================== MEDIA PLAYER ========================================
  "custom/media": {
    "format": "{}",
    "escape": true,
    "return-type": "json",
    "max-length": 40,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl stop",
    "smooth-scrolling-threshold": 2, // This value was tested using a trackpad, it should be lowered if using a mouse.
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "exec": "$HOME/.config/waybar/scripts/mediaplayer.py 2> /dev/null" // Script in resources/custom_modules folder
  },

  // ======================================== BATTERY INFO ========================================
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  // ======================================== CLOCK MODULE ========================================
  "clock": {
    //"format-alt": "󰥔   {:%I:%M %p}",
    "format": "{:%a %d/%b %I:%M%p}",
    "on-click": "kitty sh -c 'khal interactive'"
  },

  // ======================================== AUDIO MODULE ========================================
  "pulseaudio": {
    "format": "{icon} <span rise='1400'>{volume}%</span>",
    "format-muted": "󰖁",
    "scroll-step": 1,
    "on-click": "GDK_BACKEND=x11 pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"],
    "format-icons": ["<span size='120%'>󰕾</span>"]
  },

  // ======================================== NETWORK INFO ========================================
  "network": {
    "interface": "wlp9s0",
    "format": "{ifname}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀   {ipaddr}/{cidr}",
    "format-disconnected": "󰖪",
    "max-length": 50,
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", ""],
    "on-click": "~/.config/waybar/scripts/waybar_hub.sh network"
  },

  // ======================================== BRIGHTNESS CONTROL ========================================
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  }
}
