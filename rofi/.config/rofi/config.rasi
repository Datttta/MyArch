configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "Tela-circle";
    display-drun: "";
    drun-display-format: "{name}";
    font: "Sans 10";
    
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    case-sensitive: false;
    cycle: false;
}

@import "theme.rasi"
