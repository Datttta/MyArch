@import "~/.cache/wal/rofi-colors.rasi"

* {
    white: #ffffff;
    text-color:       @white;
}

window {
    width:            700px;
    height:           460px;
    /* #071010 at 55% opacity (Hex: #0710108c) */
    background-color: @background;
    border:           0px;
    border-radius:    0px;
}

mainbox {
    padding:          0px;
    background-color: transparent;
}

/* Prompt / Search container */
inputbar {
    children:         [ textbox-prompt-colon, entry ];
    background-color: @input-background;
    border:           1px;
    border-color:     @border-color;
    border-radius:    13px;
    margin:           15px;
    padding:          8px 16px;
}

/* Magnifying glass icon block */
textbox-prompt-colon {
    expand:           false;
    str:              " ";
    text-color:       #ffffff80;
    vertical-align:   0.5;
}

/* Search input field */
entry {
    padding:          10px 1px;
    border:           0px;
    text-color:       #ffffff;
    placeholder:      "";
}

/* #scroll equivalent */
listview {
    margin:           0px 20px 0px 20px;
    background-color: transparent;
    scrollbar:        false;
    border:           0px;
    padding:          0px;
    spacing:          0px;
}

/* Scrollbar styling */
scrollbar {
    width:            4px;
    handle-width:     4px;
    background-color: transparent;
}

/* #entry (unselected item) equivalent */
element {
    margin:           4px 10px;
    padding:          10px;
    background-color: transparent;
    border-radius:    0px;
    border:           0px;
}

/* Force state overrides to prevent Pywal default solid backgrounds */
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @white;
}

/* #entry:selected equivalent */
element selected.normal,
element selected.active {
    background-color: @selected-normal-background;
    border:           1px;
    border-color:     @selected-normal-background;
    border-radius:    20px;
    text-color:       @white;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

element-icon {
    background-color: transparent;
    size:             40px;
    margin:           0px 10px 0px 0px;
}

