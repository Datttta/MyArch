@import "~/.cache/wal/rofi-colors.rasi"

* {
    white: #ffffff;
    selected-normal-background: @color14;
    
    background-color: transparent;
    text-color:       @white;
}

window {
    width:            700px;
    height:           460px;
    /* #071010 at 55% opacity (Hex: #0710108c) */
    background-color: #0710108c;
    border:           0px;
    border-radius:    0px;
}

mainbox {
    padding:          0px;
    background-color: transparent;
}

/* Prompt / Search container */
inputbar {
    children:         [ entry ];
    background-color: transparent;
}

/* #input equivalent */
entry {
    margin:           15px;
    padding:          10px 16px;
    border:           1px;
    border-color:     @selected-normal-background;
    border-radius:    13px;
    /* #071010 at 50% opacity */
    background-color: #07101080;
    text-color:       @white;
}

/* #scroll equivalent */
listview {
    margin:           0px 20px 0px 20px;
    background-color: transparent;
    scrollbar:        true;
    border:           0px;
    padding:          0px;
    spacing:          0px;
}

/* Scrollbar styling */
scrollbar {
    width:            4px;
    handle-width:     4px;
    handle-color:     @selected-active-background;
    background-color: transparent;
}

/* #entry (unselected item) equivalent */
element {
    margin:           4px 10px;
    padding:          10px;
    background-color: transparent;
    border-radius:    0px;
    border:           0px;
}

/* Force state overrides to prevent Pywal default solid backgrounds */
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @white;
}

/* #entry:selected equivalent */
element selected.normal,
element selected.active {
    background-color: @selected-normal-background;
    border:           1px;
    border-color:     @selected-normal-background;
    border-radius:    20px;
    text-color:       @white;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

element-icon {
    background-color: transparent;
    size:             40px;
    margin:           0px 10px 0px 0px;
}
